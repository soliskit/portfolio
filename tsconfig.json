{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["**/*.js", "globals.d.ts"],
  "exclude": ["node_modules", ".next", "out"]
}
